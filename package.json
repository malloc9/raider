{
  "name": "raider",
  "version": "0.1.0",
  "description": "A Windows desktop tool that drives Raid: Shadow Legends accounts on the Plarium Play client",
  "main": "dist/main/main.js",
  "scripts": {
    "build": "tsc && tsc -p tsconfig.renderer.json",
    "start": "electron .",
    "dev": "concurrently \"tsc -w\" \"tsc -p tsconfig.renderer.json -w\" \"electron .\"",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "devDependencies": {
    "@types/electron": "^1.6.10",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.12.7",
    "concurrently": "^8.2.2",
    "electron": "^30.0.1",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "typescript": "^5.4.5"
  },
  "dependencies": {
    "electron-store": "^8.2.0"
  }
}