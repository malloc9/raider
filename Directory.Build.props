<Project>
  <!-- Auto-discover interop assemblies from local Plarium Play installation -->
  <PropertyGroup>
    <PlariumPlayGamePath>$([System.Environment]::GetFolderPath(LocalApplicationData))\Plarium\StandAloneApps\raid</PlariumPlayGamePath>
    <InteropSourcePath>$(PlariumPlayGamePath)\Raid_Data\Managed</InteropSourcePath>
  </PropertyGroup>

  <!-- Copy interop assemblies to plugin project if they exist -->
  <Target Name="CopyInteropAssemblies" BeforeTargets="BeforeBuild" Condition="Exists('$(InteropSourcePath)')">
    <ItemGroup>
      <InteropAssemblies Include="$(InteropSourcePath)\Assembly-CSharp.dll" />
      <InteropAssemblies Include="$(InteropSourcePath)\UnityEngine.CoreModule.dll" />
      <InteropAssemblies Include="$(InteropSourcePath)\UnityEngine.UI.dll" />
    </ItemGroup>
    <MakeDir Directories="$(MSBuildProjectDirectory)\src\Raider.Plugin\Interop" />
    <Copy SourceFiles="@(InteropAssemblies)" DestinationFolder="$(MSBuildProjectDirectory)\src\Raider.Plugin\Interop" SkipUnchangedFiles="true" />
  </Target>
</Project>