<Window x:Class="Raider.Desktop.Views.InstancesAndAccountsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Raider.Desktop.Views"
        xmlns:vm="clr-namespace:Raider.Desktop.ViewModels"
        xmlns:models="clr-namespace:Raider.Core.Models;assembly=Raider.Core"
        d:DataContext="{d:DesignInstance Type=vm:InstancesAndAccountsViewModel}"
        mc:Ignorable="d"
        Title="Raider - Instances and Accounts" 
        Height="800" Width="1100"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}">
    


    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
            <TextBlock Text="Raider" FontSize="28" FontWeight="Bold" Foreground="#0078D4" VerticalAlignment="Center" />
            <TextBlock Text="Instances and Accounts" FontSize="16" Foreground="Gray" VerticalAlignment="Center" Margin="12,0,0,0" />
        </StackPanel>

        <!-- Toolbar -->
        <Border Grid.Row="1" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12" Background="#FAFAFA">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="Refresh Instances" Command="{Binding RefreshInstancesCommand}" 
                        IsEnabled="{Binding IsRefreshing, Converter={StaticResource InverseBooleanConverter}}" 
                        MinWidth="140" />
                <Button Content="Run All" Command="{Binding RunAllInstancesCommand}" 
                        IsEnabled="{Binding IsRunningAny, Converter={StaticResource InverseBooleanConverter}}"
                        MinWidth="120"
                        Background="#107C10" Foreground="White" BorderThickness="0" Margin="12,0,0,0" />
                <ProgressBar Width="100" Height="20" IsIndeterminate="True" 
                             Visibility="{Binding IsRefreshing, Converter={StaticResource BooleanToVisibilityConverter}}"
                             VerticalAlignment="Center" Margin="12,0,0,0" />
            </StackPanel>
        </Border>

        <!-- Main Content: Instances (left) and Accounts (right) -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Instances List -->
            <Border Grid.Column="0" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="8" Padding="8" Background="#FAFAFA">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Detected Instances" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8" />

                    <ListView Grid.Row="1" ItemsSource="{Binding Instances}" 
                              BorderThickness="0" Background="Transparent"
                              HorizontalContentAlignment="Stretch">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Account" Width="180">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <TextBlock Text="{Binding AccountName}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Id}" FontSize="10" Foreground="Gray" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="State" Width="100">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding StateDisplay}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="Gray" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding State}" Value="{x:Static models:InstanceState.Running}">
                                                                <Setter Property="Foreground" Value="#0078D4" />
                                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding State}" Value="{x:Static models:InstanceState.Busy}">
                                                                <Setter Property="Foreground" Value="#0078D4" />
                                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding State}" Value="{x:Static models:InstanceState.DoneToday}">
                                                                <Setter Property="Foreground" Value="#107C10" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding State}" Value="{x:Static models:InstanceState.Failed}">
                                                                <Setter Property="Foreground" Value="#A4262C" />
                                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding State}" Value="{x:Static models:InstanceState.Duplicate}">
                                                                <Setter Property="Foreground" Value="#FFB900" />
                                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Last Run" Width="140">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding LastRunCompletedAt, Converter={StaticResource DateTimeOffsetToStringConverter}}" FontSize="12" Foreground="Gray" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Action" Width="100">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="Run now" 
                                                    Command="{Binding RunNowCommand}" 
                                                    IsEnabled="{Binding CanRunNow}"
                                                    MinWidth="80" Padding="4,2"
                                                    FontSize="12" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>
            </Border>

            <!-- Splitter -->
            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch" 
                          Background="Transparent" />

            <!-- Accounts List -->
            <Border Grid.Column="2" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="8" Padding="8" Background="#FAFAFA">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Accounts" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8" />

                    <ListBox Grid.Row="1" ItemsSource="{Binding Accounts}" BorderThickness="0" Background="Transparent"
                             HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:AccountItemViewModel}">
                                <Border BorderBrush="#DDDDDD" BorderThickness="0,0,0,1" Padding="4,6">
                                    <StackPanel>
                                        <DockPanel LastChildFill="True">
                                            <Button DockPanel.Dock="Right" Content="Delete"
                                                    Command="{Binding DataContext.RemoveAccountCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" 
                                                    Background="#A4262C" Foreground="White" BorderThickness="0"
                                                    Padding="8,2" FontSize="12" Margin="0,0,4,0" />
                                            <Button DockPanel.Dock="Right" Content="Rename"
                                                    Command="{Binding RenameCommand}"
                                                    Padding="8,2" FontSize="12" Margin="0,0,4,0" />
                                            <Button DockPanel.Dock="Right" Content="Run now"
                                                    Command="{Binding DataContext.RunAccountCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Background="#0078D4" Foreground="White" BorderThickness="0"
                                                    Padding="8,2" FontSize="12" Margin="0,0,4,0" />
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock>
                                                    <Run Text="{Binding DisplayName, Mode=OneWay}" FontWeight="SemiBold" />
                                                    <Run Text=" (" Foreground="Gray" />
                                                    <Run Text="{Binding PlariumLogin, Mode=OneWay}" Foreground="Gray" />
                                                    <Run Text=")" Foreground="Gray" />
                                                </TextBlock>
                                            </StackPanel>
                                        </DockPanel>
                                        <!-- This Account's Routine (edit inline via checkboxes) -->
                                        <ItemsControl ItemsSource="{Binding Chores}" Margin="0,4,0,0">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:ChoreToggleViewModel}">
                                                    <CheckBox Content="{Binding Name}" IsChecked="{Binding IsEnabled}" Margin="0,0,12,0" FontSize="12" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <!-- Result of this Account's last Run, one line per Chore -->
                                        <TextBlock Text="{Binding Status}" Margin="0,4,0,0" FontSize="12"
                                                   Foreground="#444444" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>

        <!-- Status Bar -->
        <StatusBar Grid.Row="3" Margin="0,12,0,0">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusMessage}" />
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <ProgressBar Width="100" Height="16" IsIndeterminate="True" 
                             Visibility="{Binding IsRefreshing, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>