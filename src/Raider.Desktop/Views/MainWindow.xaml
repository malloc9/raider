<Window x:Class="Raider.Desktop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Raider.Desktop.Views"
        xmlns:vm="clr-namespace:Raider.Desktop.ViewModels"
        xmlns:models="clr-namespace:Raider.Core.Models;assembly=Raider.Core"
        d:DataContext="{d:DesignInstance Type=vm:MainWindowViewModel}"
        mc:Ignorable="d"
        Title="Raider - Raid: Shadow Legends Automation" 
        Height="760" Width="900"
        MinHeight="500" MinWidth="700"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}">
    
    <!-- DataContext is the MainWindowViewModel injected in the constructor -->

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
            <TextBlock Text="Raider" FontSize="28" FontWeight="Bold" Foreground="#0078D4" VerticalAlignment="Center" />
            <TextBlock Text="Raid: Shadow Legends Automation" FontSize="16" Foreground="Gray" VerticalAlignment="Center" Margin="12,0,0,0" />
        </StackPanel>

        <!-- Status Cards -->
        <Border Grid.Row="1" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,12" Background="#FAFAFA">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                
                <!-- Plugin Status -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="16" Height="16" Margin="0,0,12,0" VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PluginStatus}" Value="{x:Static models:PluginInstallState.Connected}">
                                        <Setter Property="Fill" Value="#107C10" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding PluginStatus}" Value="{x:Static models:PluginInstallState.Installed}">
                                        <Setter Property="Fill" Value="#FFB900" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding PluginStatus}" Value="{x:Static models:PluginInstallState.NotInstalled}">
                                        <Setter Property="Fill" Value="#A4262C" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <StackPanel>
                        <TextBlock Text="Plugin Status" FontSize="12" Foreground="Gray" />
                        <TextBlock Text="{Binding PluginStatus}" FontSize="18" FontWeight="SemiBold" />
                    </StackPanel>
                </StackPanel>

                <!-- Game Build -->
                <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="Game Build" FontSize="12" Foreground="Gray" />
                    <TextBlock Text="{Binding GameBuild}" FontSize="18" FontWeight="SemiBold" FontFamily="Consolas" />
                </StackPanel>

                <!-- In-Game Status -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="In-Game" FontSize="12" Foreground="Gray" />
                        <TextBlock FontSize="18" FontWeight="SemiBold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="No" />
                                    <Setter Property="Foreground" Value="Gray" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsInGame}" Value="True">
                                            <Setter Property="Text" Value="Yes" />
                                            <Setter Property="Foreground" Value="#107C10" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Plugin Version" FontSize="12" Foreground="Gray" />
                        <TextBlock Text="{Binding PluginVersion}" FontSize="18" FontWeight="SemiBold" FontFamily="Consolas" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Actions -->
        <Border Grid.Row="2" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,12" Background="#FAFAFA">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="Detect Game" Command="{Binding DetectGameAndCheckStatusCommand}" 
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}" 
                        MinWidth="120" />
                <Button Content="Install Plugin" Command="{Binding InstallPluginCommand}" 
                        IsEnabled="{Binding IsInstalling, Converter={StaticResource InverseBooleanConverter}}"
                        MinWidth="140"
                        Background="#0078D4" Foreground="White" BorderThickness="0" />
                <Button Content="Check Health" Command="{Binding CheckHealthCommand}" 
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"
                        MinWidth="120" />
                <Button Content="Refresh" Command="{Binding CheckHealthCommand}" 
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"
                        MinWidth="100" />
            </StackPanel>
        </Border>

        <!-- Accounts -->
        <Border Grid.Row="3" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12" Background="#FAFAFA">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,4">
                    <TextBlock DockPanel.Dock="Left" Text="Accounts" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Button DockPanel.Dock="Right" Content="Run now (all accounts)" Command="{Binding RunAllAccountsCommand}" />
                </DockPanel>

                <!-- Add Account: Plarium login only. Raider never asks for a password. -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="Plarium login" VerticalAlignment="Center" Margin="0,0,4,0" />
                    <TextBox Text="{Binding NewPlariumLogin, UpdateSourceTrigger=PropertyChanged}" Width="220"
                             ToolTip="The email or username Plarium Play already remembers. No password needed." />
                    <TextBlock Text="Name" VerticalAlignment="Center" Margin="8,0,4,0" />
                    <TextBox Text="{Binding NewDisplayName, UpdateSourceTrigger=PropertyChanged}" Width="160" />
                    <Button Content="Add account" Command="{Binding AddAccountCommand}" />
                </StackPanel>

                <ListBox Grid.Row="2" ItemsSource="{Binding Accounts}" BorderThickness="0" Background="Transparent"
                         HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:AccountItemViewModel}">
                            <Border BorderBrush="#DDDDDD" BorderThickness="0,0,0,1" Padding="4,6">
                                <StackPanel>
                                    <DockPanel LastChildFill="True">
                                        <Button DockPanel.Dock="Right" Content="Remove"
                                                Command="{Binding DataContext.RemoveAccountCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" />
                                        <Button DockPanel.Dock="Right" Content="Run now"
                                                Command="{Binding DataContext.RunAccountCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" />
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock>
                                                <Run Text="{Binding DisplayName, Mode=OneWay}" FontWeight="SemiBold" />
                                                <Run Text="{Binding PlariumLogin, Mode=OneWay}" Foreground="Gray" />
                                            </TextBlock>
                                            <TextBlock Text="{Binding Status}" FontSize="12">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="Gray" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding NeedsManualLogin}" Value="True">
                                                                <Setter Property="Foreground" Value="#A4262C" />
                                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </DockPanel>
                                    <!-- This Account's Routine -->
                                    <ItemsControl ItemsSource="{Binding Chores}" Margin="0,4,0,0">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:ChoreToggleViewModel}">
                                                <CheckBox Content="{Binding Name}" IsChecked="{Binding IsEnabled}" Margin="0,0,12,0" FontSize="12" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- Log -->
        <Border Grid.Row="4" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="8" Padding="8" Background="White">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="Activity Log" FontSize="14" FontWeight="SemiBold" />
                    <Button Content="Clear" Command="{Binding ClearLogCommand}" 
                            HorizontalAlignment="Right" Padding="8,2" FontSize="12" />
                </StackPanel>
                
                <ListBox Grid.Row="1" ItemsSource="{Binding LogEntries}" 
                         BorderThickness="0" Background="Transparent"
                         FontFamily="Consolas" FontSize="12"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" TextWrapping="NoWrap" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- Status Bar -->
        <StatusBar Grid.Row="5" Margin="0,12,0,0">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusMessage}" />
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <ProgressBar Width="100" Height="16" IsIndeterminate="True" 
                             Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>