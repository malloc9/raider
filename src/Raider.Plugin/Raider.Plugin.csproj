<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- BepInEx 6 IL2CPP runs plugins on its bundled .NET 6 runtime -->
    <TargetFramework>net6.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <LangVersion>latest</LangVersion>
    <!-- net6.0 is out of support, but it is what BepInEx's runtime provides -->
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <!-- BepInEx pins dependency versions its feed no longer has; the nearest ones are fine for compile-only refs -->
    <NoWarn>$(NoWarn);NU1603</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Must match BepInExBuild.Version in Raider.Core (the runtime the installer puts in the game folder) -->
    <PackageReference Include="BepInEx.Unity.IL2CPP" Version="6.0.0-be.793" PrivateAssets="all" IncludeAssets="compile" />
  </ItemGroup>

  <!--
    Raid's interop assemblies (generated by BepInEx in the game folder, never committed). The plugin compiles against
    the Unity engine ones only, for its main-thread MonoBehaviour; Raid's own game code is reached by reflection.
    Without a local game install the plugin still builds, but cannot act in the game. See ADR 0004.
  -->
  <PropertyGroup>
    <RaidInteropPath>$([System.Environment]::GetFolderPath(SpecialFolder.LocalApplicationData))\PlariumPlay\StandAloneApps\raid-shadow-legends\build\BepInEx\interop</RaidInteropPath>
    <HasRaidInterop Condition="Exists('$(RaidInteropPath)\UnityEngine.CoreModule.dll')">true</HasRaidInterop>
    <DefineConstants Condition="'$(HasRaidInterop)' == 'true'">$(DefineConstants);RAID_INTEROP</DefineConstants>
  </PropertyGroup>

  <ItemGroup Condition="'$(HasRaidInterop)' == 'true'">
    <!-- Aliased: it ships public copies of compiler attributes (NullableAttribute) that clash with the runtime's -->
    <Reference Include="UnityEngine.CoreModule" HintPath="$(RaidInteropPath)\UnityEngine.CoreModule.dll" Private="false" Aliases="UnityInterop" />
    <Reference Include="Il2Cppmscorlib" HintPath="$(RaidInteropPath)\Il2Cppmscorlib.dll" Private="false" />
  </ItemGroup>

  <Target Name="WarnWithoutRaidInterop" BeforeTargets="BeforeBuild" Condition="'$(HasRaidInterop)' != 'true'">
    <Warning Code="RAIDER001" Text="Raid's interop assemblies were not found at $(RaidInteropPath); this plugin build cannot act in the game (Chores will fail). Run Raid once with BepInEx installed, then rebuild." />
  </Target>

  <ItemGroup>
    <!-- Instance registration format, shared with the other side of the plugin connection -->
    <Compile Include="..\Raider.Shared\InstanceRegistration.cs" Link="Shared\InstanceRegistration.cs" />
  </ItemGroup>

</Project>
