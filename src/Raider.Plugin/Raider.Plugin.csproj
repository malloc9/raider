<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- BepInEx 6 IL2CPP runs plugins on its bundled .NET 6 runtime -->
    <TargetFramework>net6.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <LangVersion>latest</LangVersion>
    <!-- net6.0 is out of support, but it is what BepInEx's runtime provides -->
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <!-- BepInEx pins dependency versions its feed no longer has; the nearest ones are fine for compile-only refs -->
    <NoWarn>$(NoWarn);NU1603</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Must match BepInExBuild.Version in Raider.Core (the runtime the installer puts in the game folder) -->
    <PackageReference Include="BepInEx.Unity.IL2CPP" Version="6.0.0-be.793" PrivateAssets="all" IncludeAssets="compile" />
  </ItemGroup>

  <ItemGroup>
    <!-- Interop assemblies from local game install - not committed, see ADR 0001 -->
    <Reference Include="Assembly-CSharp" HintPath="Interop/Assembly-CSharp.dll" Private="false" Condition="Exists('Interop/Assembly-CSharp.dll')" />
    <Reference Include="UnityEngine.CoreModule" HintPath="Interop/UnityEngine.CoreModule.dll" Private="false" Condition="Exists('Interop/UnityEngine.CoreModule.dll')" />
    <Reference Include="UnityEngine.UI" HintPath="Interop/UnityEngine.UI.dll" Private="false" Condition="Exists('Interop/UnityEngine.UI.dll')" />
  </ItemGroup>

  <ItemGroup>
    <!-- Instance registration format, shared with the other side of the plugin connection -->
    <Compile Include="..\Raider.Shared\InstanceRegistration.cs" Link="Shared\InstanceRegistration.cs" />
  </ItemGroup>

</Project>
