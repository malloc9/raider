<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.Analyzers" Version="1.0.0" PrivateAssets="all" />
    <PackageReference Include="BepInEx.Core" Version="6.0.0-pre.1" PrivateAssets="all" />
    <PackageReference Include="BepInEx.PluginInfoProps" Version="2.1.0" PrivateAssets="all" />
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
    <PackageReference Include="UnityEngine.Modules" Version="2022.3.20" PrivateAssets="all" IncludeAssets="compile" />
    <PackageReference Include="HarmonyX" Version="2.11.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- Interop assemblies from local game install - not committed, see ADR 0001 -->
    <Reference Include="Assembly-CSharp" HintPath="Interop/Assembly-CSharp.dll" Private="false" Condition="Exists('Interop/Assembly-CSharp.dll')" />
    <Reference Include="UnityEngine.CoreModule" HintPath="Interop/UnityEngine.CoreModule.dll" Private="false" Condition="Exists('Interop/UnityEngine.CoreModule.dll')" />
    <Reference Include="UnityEngine.UI" HintPath="Interop/UnityEngine.UI.dll" Private="false" Condition="Exists('Interop/UnityEngine.UI.dll')" />
  </ItemGroup>

</Project>